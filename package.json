{
  "name": "sailorcms",
  "private": false,
  "version": "0.5.2",
  "type": "module",
  "description": "A modern headless CMS built with SvelteKit, featuring dynamic schema generation, flexible content management, and seamless database integration.",
  "keywords": [
    "svelte",
    "sveltekit",
    "cms",
    "typescript",
    "drizzle",
    "content-management"
  ],
  "author": "Jon Kristian Nilsen",
  "license": "MIT",
  "homepage": "https://jonkristian.github.io/sailorcms/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonkristian/sailorcms.git"
  },
  "bugs": {
    "url": "https://github.com/jonkristian/sailorcms/issues"
  },
  "bin": {
    "sailor": "./bin/sailor.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./components/sailor/*": "./src/lib/components/sailor/*",
    "./core/*": "./src/lib/sailor/core/*",
    "./remote/*": "./src/lib/sailor/remote/*",
    "./utils/*": "./src/lib/sailor/utils/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "sailor": "bun cli/index.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.18.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.59.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/xmldom": "^0.1.34",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.7",
    "tailwindcss": "^4.2.4",
    "terser": "^5.46.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vite-bundle-visualizer": "^1.2.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@floating-ui/dom": "^1.7.6",
    "@internationalized/date": "^3.12.1",
    "@libsql/client": "^0.17.3",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/table-core": "^8.21.3",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/pg": "^8.20.0",
    "@xmldom/xmldom": "^0.9.10",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.9",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "fs-extra": "^11.3.4",
    "highlight.js": "^11.11.1",
    "layerchart": "2.0.0-next.48",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^8.0.7",
    "paneforge": "^1.0.2",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "^1.0.0-next.7"
  }
}
