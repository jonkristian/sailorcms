{
  "name": "sailorcms",
  "private": false,
  "version": "0.9.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "description": "A modern headless CMS built with SvelteKit, featuring dynamic schema generation, flexible content management, and seamless database integration.",
  "keywords": [
    "svelte",
    "sveltekit",
    "cms",
    "typescript",
    "drizzle",
    "content-management"
  ],
  "author": "Jon Kristian Nilsen",
  "license": "MIT",
  "homepage": "https://jonkristian.github.io/sailorcms/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonkristian/sailorcms.git"
  },
  "bugs": {
    "url": "https://github.com/jonkristian/sailorcms/issues"
  },
  "bin": {
    "sailor": "./bin/sailor.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./app": "./src/lib/sailor/app.d.ts",
    "./assets/*": "./src/lib/sailor/assets/*",
    "./composables/*": "./src/lib/sailor/composables/*",
    "./components/sailor/*": "./src/lib/components/sailor/*",
    "./components/ui/*": "./src/lib/components/ui/*",
    "./components/ui/alert": "./src/lib/components/ui/alert/index.ts",
    "./components/ui/alert-dialog": "./src/lib/components/ui/alert-dialog/index.ts",
    "./components/ui/avatar": "./src/lib/components/ui/avatar/index.ts",
    "./components/ui/badge": "./src/lib/components/ui/badge/index.ts",
    "./components/ui/breadcrumb": "./src/lib/components/ui/breadcrumb/index.ts",
    "./components/ui/button": "./src/lib/components/ui/button/index.ts",
    "./components/ui/calendar": "./src/lib/components/ui/calendar/index.ts",
    "./components/ui/card": "./src/lib/components/ui/card/index.ts",
    "./components/ui/checkbox": "./src/lib/components/ui/checkbox/index.ts",
    "./components/ui/collapsible": "./src/lib/components/ui/collapsible/index.ts",
    "./components/ui/command": "./src/lib/components/ui/command/index.ts",
    "./components/ui/dialog": "./src/lib/components/ui/dialog/index.ts",
    "./components/ui/drawer": "./src/lib/components/ui/drawer/index.ts",
    "./components/ui/dropdown-menu": "./src/lib/components/ui/dropdown-menu/index.ts",
    "./components/ui/input": "./src/lib/components/ui/input/index.ts",
    "./components/ui/input-group": "./src/lib/components/ui/input-group/index.ts",
    "./components/ui/label": "./src/lib/components/ui/label/index.ts",
    "./components/ui/pagination": "./src/lib/components/ui/pagination/index.ts",
    "./components/ui/popover": "./src/lib/components/ui/popover/index.ts",
    "./components/ui/progress": "./src/lib/components/ui/progress/index.ts",
    "./components/ui/scroll-area": "./src/lib/components/ui/scroll-area/index.ts",
    "./components/ui/select": "./src/lib/components/ui/select/index.ts",
    "./components/ui/separator": "./src/lib/components/ui/separator/index.ts",
    "./components/ui/sheet": "./src/lib/components/ui/sheet/index.ts",
    "./components/ui/sidebar": "./src/lib/components/ui/sidebar/index.ts",
    "./components/ui/skeleton": "./src/lib/components/ui/skeleton/index.ts",
    "./components/ui/switch": "./src/lib/components/ui/switch/index.ts",
    "./components/ui/table": "./src/lib/components/ui/table/index.ts",
    "./components/ui/tabs": "./src/lib/components/ui/tabs/index.ts",
    "./components/ui/textarea": "./src/lib/components/ui/textarea/index.ts",
    "./components/ui/toggle": "./src/lib/components/ui/toggle/index.ts",
    "./components/ui/toggle-group": "./src/lib/components/ui/toggle-group/index.ts",
    "./components/ui/tooltip": "./src/lib/components/ui/tooltip/index.ts",
    "./core/*": "./src/lib/sailor/core/*",
    "./core/content": "./src/lib/sailor/core/content/index.ts",
    "./core/db": "./src/lib/sailor/core/db/index.ts",
    "./core/files": "./src/lib/sailor/core/files/index.ts",
    "./core/settings": "./src/lib/sailor/core/settings/index.ts",
    "./core/ui": "./src/lib/sailor/core/ui/index.ts",
    "./remote/*": "./src/lib/sailor/remote/*",
    "./scripts/*": "./src/lib/sailor/scripts/*",
    "./utils": "./src/lib/sailor/utils/index.ts",
    "./utils/*": "./src/lib/sailor/utils/*",
    "./utils/content": "./src/lib/sailor/utils/content/index.ts",
    "./utils/data": "./src/lib/sailor/utils/data/index.ts",
    "./utils/files": "./src/lib/sailor/utils/files/index.ts",
    "./utils/i18n": "./src/lib/sailor/utils/i18n.ts",
    "./utils/site": "./src/lib/sailor/utils/site/index.ts",
    "./utils/ui": "./src/lib/sailor/utils/ui/index.ts",
    "./styles/*": "./src/lib/sailor/styles/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "paraglide-js compile --project ./src/lib/sailor/project.inlang --outdir ./src/lib/sailor/i18n/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "paraglide-js compile --project ./src/lib/sailor/project.inlang --outdir ./src/lib/sailor/i18n/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "sailor": "bun cli/index.js"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/xmldom": "^0.1.34",
    "better-auth": "^1.7.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@internationalized/date": "^3.12.4",
    "@libsql/client": "^0.17.4",
    "@lucide/svelte": "^1.42.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/pg": "^8.23.1",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.0",
    "highlight.js": "^11.12.0",
    "mode-watcher": "^1.1.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pluralize": "^8.0.0",
    "sharp": "^0.35.4",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "peerDependencies": {
    "better-auth": ">=1.6.11 <1.8.0",
    "drizzle-orm": "^0.45.2"
  }
}
